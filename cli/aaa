signal.signal(signal.SIGPIPE, signal.SIG_DFL)
try:
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")
except Exception:
    pass

COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
def C(code): return code if COLOR else ""
RESET, BOLD, DIM = C("\x1b[0m"), C("\x1b[1m"), C("\x1b[2m")
CYAN, GREEN, YELLOW, RED, GREY = C("\x1b[36m"), C("\x1b[32m"), C("\x1b[33m"), C("\x1b[31m"), C("\x1b[90m")

def out(s=""): sys.stdout.write(s + "\n")
def say(s): out("%s==> %s%s" % (CYAN + BOLD, s, RESET))
def die(msg, code=1):
    sys.stdout.flush()
    sys.stderr.write("%saaa:%s %s\n" % (GREY, RESET, msg))
    sys.exit(code)
def pretty(v): return json.dumps(v, ensure_ascii=False, indent=2)
def S(o, k, d=""):
    v = o.get(k) if isinstance(o, dict) else None
    return d if v is None else v

HOME = os.environ.get("AAA_HOME") or os.environ.get("HOME") or "/"
CFG = os.path.join(HOME, ".config", "aaa-daemon", "config.toml")
STATE = os.path.join(HOME, ".local", "state", "aaa-daemon")

# ---------------------------------------------------------------------------
# 连接
# ---------------------------------------------------------------------------
def toml_top(path, key):
    """顶层 `key = value`（第一个 [section] 之前）"""
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                if re.match(r"^\s*\[", line): break
                m = re.match(r"^\s*%s\s*=\s*(.*)$" % re.escape(key), line)
                if m:
                    v = m.group(1).strip()
                    if v.startswith('"'):
                        return re.match(r'^"([^"]*)"', v).group(1)
                    return re.split(r"[\s#]", v, maxsplit=1)[0]
    except OSError:
        return None
    return None

class Conn:
    def __init__(self):
        host = os.environ.get("AAA_HOST")
        if host:
            self.token = os.environ.get("AAA_TOKEN") or die("AAA_HOST 已设置但缺少 AAA_TOKEN")
            host = re.sub(r"^(https?|ws)://", "", host).rstrip("/")
            m = re.match(r"^\[(.+)\](?::(\d+))?$", host) or re.match(r"^([^:]+)(?::(\d+))?$", host)
            self.host, self.port = (m.group(1), int(m.group(2) or 2730)) if m else (host, 2730)
        else:
            if not os.path.exists(CFG):
                die("读不到 %s\n先在本机跑一次 aaa-daemon run，或设置 AAA_HOST/AAA_TOKEN 指向远端" % CFG)
            self.host = "127.0.0.1"
            self.port = int(toml_top(CFG, "port") or 2730)
            self.token = toml_top(CFG, "token") or die("%s: 缺少 token" % CFG)
        self.local = self.host in ("127.0.0.1", "localhost", "::1")
        h = "[%s]" % self.host if ":" in self.host else self.host
        self.base = "http://%s:%d" % (h, self.port)

    def api(self, method, path, body=None, timeout=90):
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.base + path, data=data, method=method,
                                     headers={"Authorization": "Bearer " + self.token,
                                              **({"Content-Type": "application/json"} if data else {})})
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                raw = r.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            raw = e.read().decode("utf-8", "replace")
            try:
                v = json.loads(raw); err = v.get("error", v)
                msg = err.get("message") if isinstance(err, dict) else err
            except ValueError:
                msg = raw.strip()
            raise ApiError("HTTP %s: %s" % (e.code, msg), e.code)
        except urllib.error.URLError as e:
            raise ApiError("连接 %s 失败: %s" % (self.base, e.reason), 0)
        return json.loads(raw) if raw.strip() else {}

    def wake_local(self):
        """launchd 装了但没在跑的本机 daemon 推一下；对跑着的 job 是空操作"""
        if not self.local: return False
        try:
            subprocess.run(["launchctl", "kickstart", "gui/%d/com.aaa.daemon" % os.getuid()],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        except OSError:
            return False
        for _ in range(30):
            time.sleep(0.1)
            try:
                self.api("GET", "/api/v1/health", timeout=2); return True
            except ApiError:
                pass
        return False

    def probe(self):
        try:
            return self.api("GET", "/api/v1/health", timeout=3)
        except ApiError as e:
            if e.code: die(str(e))  # daemon 在但拒绝我们（token 错）
            if self.wake_local():
                return self.api("GET", "/api/v1/health", timeout=3)
            die("连不上 daemon %s:%d\n  本机：launchctl kickstart -k gui/%d/com.aaa.daemon（未安装则 aaa service install，或前台 aaa-daemon run）\n  远端：检查 AAA_HOST / tailscale"
                % (self.host, self.port, os.getuid()))

    def wait_back(self, secs=90):
        """等重启后的 daemon 回来（/health 可达且不在 restarting）"""
        for _ in range(secs):
            try:
                h = self.api("GET", "/api/v1/health", timeout=2)
                if not h.get("restarting"): return h
            except ApiError:
                pass
            time.sleep(1)
        return None

class ApiError(Exception):
    def __init__(self, msg, code): super().__init__(msg); self.code = code

def call(conn, method, path, body=None, timeout=90):
    try:
        return conn.api(method, path, body, timeout)
    except ApiError as e:
        die(str(e))

# ---------------------------------------------------------------------------
# 会话五态（与 App 同一口径，PROTOCOL「GUI 列表口径」）
# ---------------------------------------------------------------------------
STATES = ["asking", "running", "background", "active", "paused"]
LABELS = {"asking": "待回复", "running": "运行", "background": "后台", "active": "激活", "paused": "暂停"}
COLORS = {"asking": YELLOW, "running": GREEN, "background": GREEN, "active": CYAN, "paused": GREY}

def status_of(s):
    st = S(s, "state")
    if st == "exited": return "paused"
    if s.get("asking"): return "asking"
    if st == "running": return "running"
    if s.get("background"): return "background"
    return "active"

def epoch(iso):
    """ISO 时间串 → unix 秒；解不出给 0。两处各写过一遍正则 + calendar.timegm"""
    try:
        return datetime.strptime((iso or "")[:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc).timestamp()
    except ValueError:
        return 0

def ago(iso):
    t = epoch(iso)
    if not t: return ""
    secs = int(time.time() - t)
    if secs < 60: return "%d秒" % max(secs, 0)
    if secs < 3600: return "%d分" % (secs // 60)
    if secs < 86400: return "%d小时" % (secs // 3600)
    return "%d天" % (secs // 86400)

def wid(s):
    import unicodedata
    return sum(2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in s)

def cell(s, w):
    """按显示宽度截断 / 补齐（中文两格），列才对得齐"""
    outp, n = "", 0
    for ch in s:
        cw = wid(ch)
        if n + cw > w: break
        outp += ch; n += cw
    return outp + " " * (w - n)

def uptime(secs):
    d, h, m = secs // 86400, (secs % 86400) // 3600, (secs % 3600) // 60
    if d: return "%d天 %d小时" % (d, h)
    if h: return "%d小时 %d分" % (h, m)
    return "%d分" % m

def sorted_sessions(sessions):
    """五态优先级 → 同状态里最近更新在前；终端不算"""
    return sorted((s for s in sessions if S(s, "agent") != "shell"),
                  key=lambda s: (STATES.index(status_of(s)), -_ts(s)))

def _ts(s):
    return epoch(S(s, "updated_at") or S(s, "created_at"))

