#!/usr/bin/env bash
# aaa — AAA daemon 的命令行前端（bash + curl + python3，无需构建）
#
# 这是 daemon 的终端客户端，不拥有任何会话：列表、新建、结束、回答全部走
# daemon 的 REST/WS API，所以这里开的会话在 Mac App 和手机上同样可见、可接管。
#
# 依赖：bash ≥ 3.2（macOS 自带的 /bin/bash 即可）、curl、python3（仅标准库）。
# 结构：bash 负责参数解析、配置发现、curl 调用和流程；渲染 / 目标解析 /
# WebSocket attach 客户端放在下面同一个文件里的 python 源码里（$PY_SRC），
# 每条命令只起一次 python。

VERSION="1.2.0"

HELP="aaa — AAA daemon 的命令行前端

  aaa                      交互菜单（执行中 / 待回复 / 已完成 分组；数字接入会话，p 项目 m 权限 n 新建）
  aaa ls [-a] [--json]     会话列表（-a 含已退出）
  aaa ps [--json]          项目列表
  aaa new [名字] [-a AGENT]  新建项目目录 + 开一个会话并接入
  aaa open <目标> [--fresh]   进入项目（有活会话就接回，否则 resume；--fresh 强制再开一个并行会话）
  aaa attach <目标>         接入会话（Ctrl-] 脱离，会话继续跑）
  aaa say <目标> <文本…>     把一句话写进会话并回车（回答提问用）
  aaa kill <目标>           结束会话
  aaa rm <目标>             删除会话记录
  aaa rename <目标> <标题>   重命名会话
  aaa wait [--json]         只列有表单等你回答的会话 (asking)
  aaa status [--json]       daemon 状态
  aaa perms [--json]        macOS 权限状态
  aaa perms all | <id…>     申请权限（弹窗出现在 Mac 上）
  aaa help

目标可以是：会话 id 或其前缀、aaa ls 里的序号、项目名（取最近的活会话）、
或 \`.\` 表示当前目录所属的项目。

连接：默认读 ~/.config/aaa-daemon/config.toml 连本机 daemon；
      设 AAA_HOST=主机:2730 AAA_TOKEN=… 可指向另一台机器的 daemon。
"

# ---------------------------------------------------------------------------
# colours: ANSI only when stdout is a tty and NO_COLOR is unset
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  AAA_COLOR=1
  RESET=$'\033[0m' BOLD=$'\033[1m' DIM=$'\033[2m' CYAN=$'\033[36m'
  YELLOW=$'\033[33m' GREY=$'\033[90m'
else
  AAA_COLOR=0
  RESET='' BOLD='' DIM='' CYAN='' YELLOW='' GREY=''
fi
export AAA_COLOR

HOST='' PORT='' TOKEN='' BASE='' LOCAL=0 CONNECT_TIMEOUT=2
ERRFILE='' MAPFILE='' HDRFILE='' SAVED_STTY='' IN_MENU=''
KEY='' PICKED='' REPLY_LINE='' MENU_STATUS=''
R_ID='' R_CERT='' R_PROJECT='' R_STATE='' R_PATH='' R_AGENT='' R_TITLE=''
# field separator between python and bash: US (0x1f) is not IFS whitespace,
# so an empty middle field (blank project_name, agent) does not collapse
US=$'\037'

cleanup() {
  [ -n "$SAVED_STTY" ] && stty "$SAVED_STTY" 2>/dev/null
  [ -n "$IN_MENU" ] && printf '\033[0m'
  [ -n "$ERRFILE" ] && rm -f "$ERRFILE"
  [ -n "$MAPFILE" ] && rm -f "$MAPFILE"
  [ -n "$HDRFILE" ] && rm -f "$HDRFILE"
  return 0
}
trap cleanup EXIT

die() {
  printf '%saaa:%s %s\n' "$GREY" "$RESET" "$*" >&2
  exit 1
}
die_api() { die "$(cat "$ERRFILE" 2>/dev/null)"; }

is_tty() { [ -t 0 ] && [ -t 1 ]; }
clear_screen() { printf '\033[2J\033[H'; }

# JSON string literal (with quotes) from arbitrary text
json_str() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}

# ---------------------------------------------------------------------------
# the python half: rendering, target resolution, menu frames, WebSocket attach
# ---------------------------------------------------------------------------
IFS= read -r -d '' PY_SRC <<'PY' || true
import calendar, json, os, re, signal, sys, time, unicodedata

signal.signal(signal.SIGPIPE, signal.SIG_DFL)
try:
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")
except Exception:
    pass

COLOR = os.environ.get("AAA_COLOR") == "1"
def C(code): return code if COLOR else ""
RESET, BOLD, DIM = C("\x1b[0m"), C("\x1b[1m"), C("\x1b[2m")
CYAN, GREEN, YELLOW = C("\x1b[36m"), C("\x1b[32m"), C("\x1b[33m")
RED, MAGENTA, GREY = C("\x1b[31m"), C("\x1b[35m"), C("\x1b[90m")
EOL = "\x1b[K"   # erase to end of line: menu frames only (always a tty)

def out(s=""):
    sys.stdout.write(s + "\n")

def die(msg, code=1):
    # code 2 = "nothing matched" (callers may fall back); 1 = a real error
    # such as ambiguity or an out-of-range row, which must never be guessed
    # past. AAA_BARE=1: bash captures stderr and adds the prefix itself.
    sys.stdout.flush()
    prefix = "" if os.environ.get("AAA_BARE") == "1" else "%saaa:%s " % (GREY, RESET)
    sys.stderr.write(prefix + msg + "\n")
    sys.exit(code)

def load():
    raw = sys.stdin.buffer.read().decode("utf-8", "replace")
    try:
        return json.loads(raw)
    except ValueError as e:
        die("响应解析失败: %s" % e)

def pretty(v):
    return json.dumps(v, ensure_ascii=False, indent=2)

def term_size():
    try:
        sz = os.get_terminal_size(1)
        if sz.columns > 0:
            return sz.columns, max(sz.lines, 10)
    except OSError:
        pass
    return 120, 40

SEP = "\x1f"   # unit separator: bash reads it with IFS=$'\037', empty fields survive

def clean(s):
    return str(s).replace(SEP, " ").replace("\t", " ").replace("\n", " ").replace("\r", " ")

# ---- cells: CJK and full-width forms take two columns ----
def cw(ch):
    o = ord(ch)
    if o < 0x20 or o == 0x7F:
        return 0
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1

def width(s): return sum(cw(c) for c in s)

def truncate(s, w):
    if width(s) <= w:
        return s
    if w <= 0:
        return ""
    acc, used = [], 0
    for c in s:
        k = cw(c)
        if used + k > w - 1:
            break
        acc.append(c); used += k
    return "".join(acc) + "…"

def cell(s, w):
    t = truncate(s, w)
    return t + " " * max(0, w - width(t))

# ---- time ----
ISO = re.compile(r"^(\d{4})-(\d\d)-(\d\d)[T ](\d\d):(\d\d):(\d\d)(?:\.\d+)?(Z|[+-]\d\d:?\d\d)?$")
def parse_iso(s):
    m = ISO.match(s or "")
    if not m:
        return None
    y, mo, d, h, mi, se = (int(x) for x in m.groups()[:6])
    t = calendar.timegm((y, mo, d, h, mi, se, 0, 0, 0))
    tz = m.group(7)
    if tz and tz != "Z":
        sign = 1 if tz[0] == "+" else -1
        t -= sign * (int(tz[1:3]) * 3600 + int(tz[-2:]) * 60)
    return t

def ago(iso):
    t = parse_iso(iso)
    if t is None:
        return ""
    secs = int(time.time() - t)
    if secs < 0: return "刚刚"
    if secs < 60: return "%d秒" % secs
    if secs < 3600: return "%d分" % (secs // 60)
    if secs < 86400: return "%d小时" % (secs // 3600)
    return "%d天" % (secs // 86400)

def uptime(secs):
    d, h, m = secs // 86400, (secs % 86400) // 3600, (secs % 3600) // 60
    if d > 0: return "%d天 %d小时" % (d, h)
    if h > 0: return "%d小时 %d分" % (h, m)
    return "%d分" % m

def human_size(n):
    units = ["B", "K", "M", "G", "T"]
    v, i = float(n), 0
    while v >= 1024.0 and i < len(units) - 1:
        v /= 1024.0; i += 1
    if i == 0: return "%d%s" % (n, units[0])
    if v < 10.0: return "%.1f%s" % (v, units[i])
    return "%.0f%s" % (v, units[i])

# ---- sessions ----
def S(o, k, d=""):
    v = o.get(k) if isinstance(o, dict) else None
    return d if v is None else v

def is_live(s): return S(s, "state") != "exited"
def is_asking(s): return bool(s.get("asking"))

def headline(s):
    return S(s, "title")

GROUP_NAMES = ["执行中", "待回复", "已完成"]
GROUP_COLORS = [GREEN, YELLOW, GREY]

def group_of(s):
    st = S(s, "state")
    if is_asking(s): return 1
    if st == "running": return 0
    return 2

def sort_for_listing(sessions):
    # stable sorts: most recent output first, then by group, exited last overall
    v = sorted(sessions, key=lambda s: S(s, "last_output_at"), reverse=True)
    return sorted(v, key=lambda s: (group_of(s), 0 if is_live(s) else 1))

def state_color(state):
    return {"running": GREEN, "waiting": YELLOW, "exited": RED}.get(state, GREY)

def state_label(s):
    st = S(s, "state")
    if st == "running": return "运行中"
    if st == "waiting": return "待回复" if is_asking(s) else "等你"
    if st == "exited":
        code = s.get("exit_code")
        return "已退出" if code in (None, 0) else "退出 %s" % code
    return st

def agent_color(agent):
    return {"claude": C("\x1b[38;5;179m"), "codex": C("\x1b[38;5;111m"),
            "pi": C("\x1b[38;5;150m"), "reasonix": C("\x1b[38;5;175m"),
            "agy": C("\x1b[38;5;140m")}.get(agent, GREY)

def perm_status(status):
    return {"granted": (GREEN, "已授权"), "denied": (RED, "已拒绝"),
            "undetermined": (YELLOW, "未申请"),
            "needs_settings": (CYAN, "需手动开")}.get(status, (GREY, "未知"))

def session_row(s, w):
    st = S(s, "state")
    dot = state_color(st) + "●" + RESET
    name = BOLD + cell(S(s, "project_name"), 14) + RESET
    agent = agent_color(S(s, "agent")) + cell(S(s, "agent"), 9) + RESET
    state = state_color(st) + cell(state_label(s), 9) + RESET
    when = DIM + cell(ago(S(s, "last_output_at")), 5) + RESET
    head = truncate(headline(s), max(w - 43, 10))   # 1+1+14+1+9+1+9+1+5+1 = 43
    return "%s %s %s %s %s %s%s%s" % (dot, name, agent, state, when, DIM, head, RESET)

def project_row(p, w):
    name = BOLD + cell(S(p, "name"), 18) + RESET
    agent = agent_color(S(p, "agent")) + cell(S(p, "agent"), 9) + RESET
    size = cell(human_size(int(S(p, "dir_size", 0) or 0)), 6)
    c = S(p, "ctx_size", 0) or 0
    ctx = cell(human_size(int(c)), 6) if c > 0 else cell("-", 6)
    when = cell(ago(S(p, "mtime")), 5)
    title = truncate(S(p, "session_title"), max(w - 49, 10))  # 18+1+9+1+6+1+6+1+5+1
    return "%s %s %s%s %s %s%s %s%s%s" % (name, agent, DIM, size, ctx, when, RESET, CYAN, title, RESET)

def display_key(k):
    if not k: return "·"
    if k.startswith("\x1b"): return "↓" * k.count("\x1b")
    return k

def root_state(h):
    rs = S(h, "root_state")
    if rs: return rs
    return "ok" if h.get("ssd_mounted") else "unmounted"

def err_message(raw):
    try:
        v = json.loads(raw)
    except ValueError:
        return raw.strip()
    if isinstance(v, dict):
        if isinstance(v.get("message"), str): return v["message"]
        e = v.get("error")
        if isinstance(e, str): return e
        if isinstance(e, dict) and isinstance(e.get("message"), str): return e["message"]
    return raw.strip()

def summarize_request(v):
    def lst(k):
        a = v.get(k) if isinstance(v, dict) else None
        return " ".join(x for x in a if isinstance(x, str)) if isinstance(a, list) else ""
    parts = []
    if lst("triggered"): parts.append("已弹窗: " + lst("triggered"))
    if lst("opened_settings"): parts.append("已打开设置面板（需手动开）: " + lst("opened_settings"))
    return " · ".join(parts) if parts else "没有需要申请的项"

# ---- verbs ----
def cmd_ls(args):
    ordered = sort_for_listing(load())
    show_all = "-a" in args
    cols, _ = term_size()
    rows = [(i + 1, s) for i, s in enumerate(ordered) if show_all or is_live(s)]
    if not rows:
        out(DIM + "没有会话" + RESET); return
    cur = None
    for n, s in rows:
        g = group_of(s)
        if g != cur:
            cur = g
            out("%s%s%s" % (GROUP_COLORS[g], GROUP_NAMES[g], RESET))
        out("%s%2d%s %s" % (DIM, n, RESET, session_row(s, max(cols - 4, 0))))

def cmd_ps(args):
    cols, _ = term_size()
    for i, p in enumerate(load()):
        out("%s%2d%s %s" % (DIM, i + 1, RESET, project_row(p, max(cols - 4, 0))))

def waiting_only(sessions):
    return [s for s in sort_for_listing(sessions) if is_asking(s)]

def cmd_wait(args):
    sessions = waiting_only(load())
    if "--json" in args:
        v = []
        for s in sessions:
            v.append({"id": S(s, "id"), "project": S(s, "project_name"), "path": S(s, "project_path"),
                      "agent": S(s, "agent"), "title": S(s, "title")})
        out(pretty(v)); return
    if not sessions:
        out(DIM + "没有会话在等你回答" + RESET); return
    for s in sessions:
        out("%s●%s %s%s%s  %s%s%s" % (YELLOW, RESET, BOLD, S(s, "project_name"), RESET, DIM, S(s, "id"), RESET))
        out("   " + S(s, "title"))

def cmd_status(args):
    host, port = args[0], args[1]
    data = load()
    h = data[0] if isinstance(data[0], dict) else {}
    sessions = data[1] if isinstance(data[1], list) else []
    live = sum(1 for s in sessions if is_live(s))
    waiting = sum(1 for s in sessions if group_of(s) == 1)
    rs = root_state(h)
    if "--json" in args:
        out(pretty({"host": host, "port": int(port), "version": S(h, "version"),
                    "ssd_mounted": bool(h.get("ssd_mounted")), "root_state": rs,
                    "project_root": S(h, "project_root"), "uptime_s": S(h, "uptime_s", 0),
                    "sessions": live, "waiting": waiting}))
        return
    note = {"ok": "", "denied": RED + "(读不了 · 缺完全磁盘访问权限)" + RESET}.get(rs, RED + "(未挂载!)" + RESET)
    out("%saaa-daemon%s v%s  %s%s:%s%s" % (BOLD, RESET, S(h, "version"), DIM, host, port, RESET))
    out("  项目根   %s %s" % (S(h, "project_root"), note))
    out("  运行时长 %s" % uptime(int(S(h, "uptime_s", 0) or 0)))
    out("  会话     %d 活跃 · %d 待回复 · %d 总计" % (live, waiting, len(sessions)))
    if rs == "denied":
        out("\n%s项目根读不了%s：launchd 起的 daemon 没有可移动卷访问权。\n  "
            "系统设置 → 隐私与安全性 → 完全磁盘访问权限，加入 %s~/.local/bin/aaa-daemon%s，\n  "
            "然后 %saaa-daemon service uninstall && aaa-daemon service install%s"
            % (YELLOW, RESET, DIM, RESET, BOLD, RESET))

def cmd_perms(args):
    for p in load():
        color, label = perm_status(S(p, "status"))
        line = "  %s %s%s%s  %s%s%s" % (cell(S(p, "label"), 22), color, cell(label, 8), RESET,
                                          DIM, cell(S(p, "id"), 26), RESET)
        hint = S(p, "hint")
        if hint:
            line += "  %s%s%s" % (DIM, hint, RESET)
        out(line.rstrip())

def cmd_perm_summary(args):
    out(summarize_request(load()))

def cmd_purge_summary(args):
    v = load()
    parts = ["已删除 %s" % args[0]]
    for r in (v.get("results") or []) if isinstance(v, dict) else []:
        for p in (r.get("purged") or []) if isinstance(r, dict) else []:
            if isinstance(p, dict) and (p.get("count") or 0) > 0:
                parts.append("%s %s 条" % (S(p, "agent_label"), p.get("count")))
    out(" · ".join(parts))

def cmd_fields(args):
    v = load()
    vals = []
    for k in args:
        x = v.get(k) if isinstance(v, dict) else None
        if x is None: vals.append("")
        elif isinstance(x, str): vals.append(clean(x))
        else: vals.append(clean(json.dumps(x, ensure_ascii=False)))
    out(SEP.join(vals))

# ---- target resolution (= the Rust cmds::resolve_in) ----
def normalize(target, cwd, health):
    if target != ".":
        return target
    root = S(health, "project_root")
    if not root:
        die("daemon 没有报告项目根，无法解析 .")
    rootp = root.rstrip("/") or "/"
    cwdp = cwd.rstrip("/") or "/"
    if cwdp == rootp:
        die("当前目录就是项目根")
    prefix = rootp if rootp.endswith("/") else rootp + "/"
    if not cwdp.startswith(prefix):
        die("当前目录不在项目根 %s 下" % root)
    return cwdp[len(prefix):].split("/")[0]

def resolve_in(ordered, target):
    for s in ordered:
        if S(s, "id") == target:
            return s, True
    if target.isdigit():
        n = int(target)
        if 1 <= n <= len(ordered):
            return ordered[n - 1], False
        die("序号 %d 超出范围（当前 %d 个会话）" % (n, len(ordered)))
    pref = [s for s in ordered if S(s, "id").startswith(target)]
    if len(pref) == 1:
        return pref[0], True
    if len(pref) > 1:
        die("%s 匹配到 %d 个会话，请写全 id" % (target, len(pref)))
    lower = target.lower()
    for s in ordered:
        if S(s, "project_name").lower() == lower or S(s, "project_path") == target:
            return s, False
    fuzzy = [s for s in ordered if lower in S(s, "project_name").lower()]
    if len(fuzzy) == 1:
        return fuzzy[0], False
    if len(fuzzy) > 1:
        die("%s 模糊匹配到 %d 个会话（%s），写全项目名或 id"
            % (target, len(fuzzy), " ".join(S(s, "project_name") for s in fuzzy)))
    die("没有匹配 %s 的会话（aaa ls -a 看看）" % target, 2)

def cmd_resolve(args):
    target, cwd = args[0], args[1]
    health = json.loads(args[2]) if len(args) > 2 and args[2] else {}
    live_only = "--live" in args[3:]
    target = normalize(target, cwd, health)
    ordered = sort_for_listing(load())
    s, exact = resolve_in(ordered, target)
    if live_only and not is_live(s):
        die("没有匹配 %s 的活会话" % target, 2)
    out(SEP.join([S(s, "id"), "exact" if exact else "positional", clean(S(s, "project_name")),
                   state_label(s), clean(S(s, "project_path")), clean(S(s, "agent")), clean(S(s, "title"))]))

def cmd_find_project(args):
    target, cwd = args[0], args[1]
    health = json.loads(args[2]) if len(args) > 2 and args[2] else {}
    want = normalize(target, cwd, health)
    projects = load()
    # an exact name or path wins; a substring must be unique — picking the
    # first of several would silently resume the wrong project
    hit = None
    for p in projects:
        if S(p, "path") == want or S(p, "name") == want:
            hit = p; break
    if hit is None:
        fuzzy = [p for p in projects if want.lower() in S(p, "name").lower()]
        if len(fuzzy) == 1:
            hit = fuzzy[0]
        elif len(fuzzy) > 1:
            die("%s 模糊匹配到 %d 个项目（%s），写全项目名"
                % (target, len(fuzzy), " ".join(S(p, "name") for p in fuzzy)))
    if hit is None:
        die("没有匹配 %s 的项目" % target, 2)
    out(SEP.join([clean(S(hit, "path")), clean(S(hit, "agent")), clean(S(hit, "name"))]))

def cmd_live_for_path(args):
    path = args[0]
    live = [s for s in load() if is_live(s) and S(s, "project_path") == path]
    if live:
        s = max(live, key=lambda s: S(s, "last_output_at"))
        out(SEP.join([S(s, "id"), clean(S(s, "title"))]))

# ---- menu frames: write the frame to stdout, the row map to a file ----
def frame(lines):
    sys.stdout.write("\x1b[H" + "\n".join(lines) + "\x1b[J")
    sys.stdout.flush()

def marker(sel): return BOLD + CYAN + "▶" + RESET if sel else " "

def cmd_menu(args):
    mapf, host, port = args[0], args[1], args[2]
    status = args[3] if len(args) > 3 else ""
    data = load()
    h = data.get("health") or {}
    ordered = sort_for_listing(data.get("sessions") or [])
    cols, rows = term_size()
    rs = root_state(h)
    root = {"ok": "SSD 已挂载", "unmounted": "SSD 未挂载"}.get(rs, "项目根读不了 · 缺完全磁盘访问权限")
    lines = [
        "%s%s   ░█▀█░█▀█░█▀█%s%s" % (BOLD, MAGENTA, RESET, EOL),
        "%s%s   ░█▀█░█▀█░█▀█%s%s    %s:%s · v%s · %s%s%s" % (BOLD, MAGENTA, RESET, DIM, host, port, S(h, "version"), root, RESET, EOL),
        "%s%s   ░▀░▀░▀░▀░▀░▀%s%s" % (BOLD, MAGENTA, RESET, EOL),
        EOL,
    ]
