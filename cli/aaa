# ---------------------------------------------------------------------------
# connection discovery
# ---------------------------------------------------------------------------
# `key = value` at the top level of a toml file (before the first [section])
toml_top() {
  awk -v k="$1" '
    /^[[:space:]]*\[/ { exit }
    $0 ~ "^[[:space:]]*" k "[[:space:]]*=" {
      v = $0; sub(/^[^=]*=[[:space:]]*/, "", v)
      if (substr(v, 1, 1) == "\"") { match(v, /^"[^"]*"/); v = substr(v, 2, RLENGTH - 2) }
      else { sub(/[[:space:]#].*$/, "", v) }
      print v; exit
    }' "$2"
}

# host[:port] with bracketed IPv6 literals kept intact
split_host() {
  local s=$1 tail h
  s=${s#http://}; s=${s#ws://}
  while case $s in */) true;; *) false;; esac; do s=${s%/}; done
  case $s in
    \[*\]*)
      HOST=${s#\[}; HOST=${HOST%%\]*}
      tail=${s#*\]}
      case $tail in :*) PORT=${tail#:};; *) PORT=2730;; esac ;;
    *:*)
      h=${s%:*}
      case $h in
        *:*) HOST=$s; PORT=2730 ;;        # a bare v6 literal: several colons, no port
        *)   HOST=$h; PORT=${s##*:} ;;
      esac ;;
    *) HOST=$s; PORT=2730 ;;
  esac
  case $PORT in ''|*[!0-9]*) PORT=2730;; esac
}

discover() {
  local cfg home
  if [ -n "${AAA_HOST:-}" ]; then
    [ -n "${AAA_TOKEN:-}" ] || die "AAA_HOST 已设置但缺少 AAA_TOKEN"
    TOKEN=$AAA_TOKEN
    split_host "$AAA_HOST"
  else
    home=${AAA_HOME:-}; [ -n "$home" ] || home=${HOME:-/}
    cfg="$home/.config/aaa-daemon/config.toml"
    [ -r "$cfg" ] || die "读不到 $cfg
先在本机跑一次 aaa-daemon run，或设置 AAA_HOST/AAA_TOKEN 指向远端"
    HOST=127.0.0.1
    PORT=$(toml_top port "$cfg"); TOKEN=$(toml_top token "$cfg")
    case $PORT in ''|*[!0-9]*) PORT=2730;; esac
    [ -n "$TOKEN" ] || die "$cfg: 缺少 token"
  fi
  case $HOST in 127.0.0.1|localhost|::1) LOCAL=1; CONNECT_TIMEOUT=2;; *) LOCAL=0; CONNECT_TIMEOUT=6;; esac
  case $HOST in *:*) BASE="http://[$HOST]:$PORT";; *) BASE="http://$HOST:$PORT";; esac
}

# ---------------------------------------------------------------------------
# HTTP: api METHOD PATH [JSON-BODY] → body on stdout; on failure the message
# goes to $ERRFILE and the return code is 1. The bearer token reaches curl
# through $HDRFILE (0600), never through argv — argv is visible to every user
# on the host via ps for the life of the request.
# ---------------------------------------------------------------------------
api() {
  local method=$1 path=$2 out rc code body
  if [ $# -ge 3 ]; then
    out=$(curl -s --connect-timeout "$CONNECT_TIMEOUT" --max-time 90 -X "$method" \
      -K "$HDRFILE" -H 'Content-Type: application/json' \
      --data-binary "$3" -w '\n%{http_code}' "$BASE$path" 2>/dev/null)
  else
    out=$(curl -s --connect-timeout "$CONNECT_TIMEOUT" --max-time 90 -X "$method" \
      -K "$HDRFILE" -w '\n%{http_code}' "$BASE$path" 2>/dev/null)
  fi
  rc=$?
  if [ $rc -ne 0 ]; then
    case $rc in
      6) printf '连接 %s 失败: 无法解析主机\n' "$BASE" ;;
      7) printf '连接 %s 失败: 连接被拒绝\n' "$BASE" ;;
      28) printf '连接 %s 失败: 超时\n' "$BASE" ;;
      *) printf '连接 %s 失败 (curl exit %s)\n' "$BASE" "$rc" ;;
    esac >"$ERRFILE"
    return 1
  fi
  code=${out##*$'\n'}; body=${out%$'\n'*}
  case $code in
    2*) printf '%s' "$body"; return 0 ;;
  esac
  printf 'HTTP %s: %s\n' "$code" "$(printf '%s' "$body" | py errmsg)" >"$ERRFILE"
  return 1
}

# a launchd-managed local daemon that is installed but not running gets one
# nudge; kickstart on a running job is a no-op, so this is safe to try
wake_local() {
  [ "$LOCAL" = 1 ] || return 1
  command -v launchctl >/dev/null 2>&1 || return 1
  launchctl kickstart "gui/$(id -u)/com.aaa.daemon" >/dev/null 2>&1 || return 1
  local i=0
  while [ $i -lt 30 ]; do
    sleep 0.1
    api GET /api/v1/health >/dev/null 2>&1 && return 0
    i=$((i + 1))
  done
  return 1
}

probe() {
  api GET /api/v1/health >/dev/null 2>&1 && return 0
  # the daemon answered but refused us (bad token): that is not "unreachable"
  case $(cat "$ERRFILE" 2>/dev/null) in HTTP*) die_api ;; esac
  wake_local && return 0
  die "连不上 daemon $HOST:$PORT
  本机：launchctl kickstart -k gui/$(id -u)/com.aaa.daemon（未安装则 aaa-daemon service install，或前台 aaa-daemon run）
  远端：检查 AAA_HOST / tailscale"
}

