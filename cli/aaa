def cmd_status(conn, args):
    h = conn.probe()
    sessions = call(conn, "GET", "/api/v1/sessions")
    counts = {k: 0 for k in STATES}
    for s in sessions:
        if S(s, "agent") != "shell": counts[status_of(s)] += 1
    rs = S(h, "root_state") or ("ok" if h.get("ssd_mounted") else "unmounted")
    if "--json" in args:
        out(pretty({"host": conn.host, "port": conn.port, "version": S(h, "version"), "root_state": rs,
                    "project_root": S(h, "project_root"), "uptime_s": S(h, "uptime_s", 0),
                    "update_pending": bool(h.get("update_pending")), "counts": counts})); return
    note = {"ok": "", "denied": RED + "(读不了 · 缺完全磁盘访问权限)" + RESET}.get(rs, RED + "(未挂载!)" + RESET)
    flags = []
    if h.get("update_pending"): flags.append("新二进制已装好，等重启")
    if h.get("restart_scheduled"): flags.append("等空闲重启")
    elif idle_watch_pid(): flags.append("等空闲重启（CLI 守望 %d）" % idle_watch_pid())
    out("%saaa-daemon%s v%s  %s%s:%d%s%s" % (BOLD, RESET, S(h, "version"), DIM, conn.host, conn.port, RESET,
                                           ("  " + YELLOW + " · ".join(flags) + RESET) if flags else ""))
    out("  项目根   %s %s" % (S(h, "project_root"), note))
    out("  运行时长 %s" % uptime(int(S(h, "uptime_s", 0) or 0)))
    out("  会话     " + " · ".join("%s%s %d%s" % (COLORS[k], LABELS[k], counts[k], RESET) for k in STATES))
    if rs == "denied":
        out("\n%s项目根读不了%s：launchd 起的 daemon 没有可移动卷访问权。\n  系统设置 → 隐私与安全性 → 完全磁盘访问权限，加入 %s~/.local/bin/aaa-daemon%s，\n  然后 %saaa service uninstall && aaa service install%s"
            % (YELLOW, RESET, DIM, RESET, BOLD, RESET))

def cmd_ls(conn, args):
    conn.probe()
    sessions = call(conn, "GET", "/api/v1/sessions")
    if "--json" in args: out(pretty(sessions)); return
    show_all = "-a" in args or "--all" in args
    rows = [s for s in sorted_sessions(sessions) if show_all or status_of(s) != "paused"]
    if not rows: out(DIM + "没有会话" + RESET); return
    cur = None
    for s in rows:
        st = status_of(s)
        if st != cur:
            cur = st; out("%s%s%s" % (COLORS[st], LABELS[st], RESET))
        out("  %s%s%s %s%s%s %s  %s%s%s" % (DIM, cell(S(s, "id"), 11), RESET, BOLD, cell(S(s, "project_name"), 18), RESET,
                                          S(s, "title"), DIM, ago(S(s, "updated_at") or S(s, "created_at")), RESET))

def cmd_wait(conn, args):
    conn.probe()
    sessions = [s for s in sorted_sessions(call(conn, "GET", "/api/v1/sessions")) if status_of(s) == "asking"]
    if "--json" in args:
        out(pretty([{"id": S(s, "id"), "project": S(s, "project_name"), "path": S(s, "project_path"), "title": S(s, "title")} for s in sessions])); return
    if not sessions: out(DIM + "没有会话在等你回答" + RESET); return
    for s in sessions:
        out("%s●%s %s%s%s  %s%s%s\n   %s" % (YELLOW, RESET, BOLD, S(s, "project_name"), RESET, DIM, S(s, "id"), RESET, S(s, "title")))

def cmd_perms(conn, args):
    conn.probe()
    ids = [a for a in args if not a.startswith("-")]
    if ids:
        body = {"ids": ["all"] if ids == ["all"] else ids}
        v = call(conn, "POST", "/api/v1/mac/permissions/request", body)
        out(pretty(v) if "--json" in args else "已发起：%s" % (", ".join(S(x, "id") if isinstance(x, dict) else str(x) for x in (v.get("requested") or v.get("ids") or [])) or json.dumps(v, ensure_ascii=False)))
        out(DIM + "弹窗出现在 Mac 上；辅助功能 / 屏幕录制 / 完全磁盘访问 要在系统设置里勾上 aaa-daemon，改完重启 daemon 才能读到" + RESET)
        return
    v = call(conn, "GET", "/api/v1/mac/permissions")
    if "--json" in args: out(pretty(v)); return
    lab = {"granted": (GREEN, "已授权"), "denied": (RED, "已拒绝"), "undetermined": (YELLOW, "未申请"), "needs_settings": (CYAN, "需手动开")}
    for p in v:
        color, label = lab.get(S(p, "status"), (GREY, "未知"))
        line = "  %-22s %s%-8s%s  %s%-26s%s" % (S(p, "label"), color, label, RESET, DIM, S(p, "id"), RESET)
        if S(p, "hint"): line += "  %s%s%s" % (DIM, S(p, "hint"), RESET)
        out(line.rstrip())

def live_titles(conn):
    return [S(s, "title") or S(s, "id") for s in call(conn, "GET", "/api/v1/sessions") if S(s, "state") != "exited"]

def cmd_restart(conn, args):
    h = conn.probe()
    force = "--force" in args or "-f" in args
    if "--cancel" in args:
        cancel_idle_watch(); return
    if "--when-idle" in args or "--idle" in args:
        # 等所有会话都停在输入框再重启：daemon 记下约定，tick 里兑现；不用你挑时间。
        # 1.15 之前的 daemon 不认 when_idle（会按普通 restart 处理、有活会话就 409），
        # 那就由 CLI 起一个后台守望进程替它盯着：没有会话在「运行」就 --force 重启
        if ver_tuple(S(h, "version")) < (1, 15, 0):
            start_idle_watch(conn, h); return
        v = call(conn, "POST", "/api/v1/restart", {"when_idle": True})
        if v.get("scheduled"):
            say("已约好：%d 个会话还在跑，等它们都停下再重启（aaa status 能看到「等空闲重启」）" % v.get("running", 0)); return
        say("此刻没有在跑的会话，直接重启" + ("（结束了：%s）" % "、".join(v["killed"]) if v.get("killed") else ""))
        time.sleep(2)
        h2 = conn.wait_back() or die("90 秒内没回来，看 %s/daemon.err.log" % STATE)
        say("回来了：v%s" % S(h2, "version")); return
    live = live_titles(conn)
    if live and not force:
        die("有 %d 个活会话（%s）。加 --force：先结束它们，daemon 起来后自动 resume" % (len(live), "、".join(live[:5]) + ("…" if len(live) > 5 else "")))
    say("重启 daemon v%s%s" % (S(h, "version"), "（新二进制已装好）" if h.get("update_pending") else ""))
    v = call(conn, "POST", "/api/v1/restart", {"force": force})
    if v.get("killed"): out("  结束了：" + "、".join(v["killed"]))
    time.sleep(2)
    h2 = conn.wait_back()
    if not h2: die("90 秒内没回来，看 %s/daemon.err.log" % STATE)
    say("回来了：v%s，项目根 %s" % (S(h2, "version"), S(h2, "project_root")))

IDLE_PID = os.path.join(STATE, "idle-restart.pid")
IDLE_LOG = os.path.join(STATE, "idle-restart.log")

def idle_watch_pid():
    """守望进程还在就返回 pid，否则清掉陈旧 pidfile 返回 None"""
    try: pid = int(open(IDLE_PID).read().strip())
    except (OSError, ValueError): return None
    try: os.kill(pid, 0); return pid
    except OSError:
        try: os.remove(IDLE_PID)
        except OSError: pass
        return None

def start_idle_watch(conn, h):
    pid = idle_watch_pid()
    if pid: say("已经在等空闲重启了（守望进程 %d，日志 %s；aaa restart --cancel 取消）" % (pid, IDLE_LOG)); return
    os.makedirs(STATE, exist_ok=True)
    log = open(IDLE_LOG, "ab")
    child = subprocess.Popen([sys.executable, os.path.abspath(__file__), "_idle-watch"], stdin=subprocess.DEVNULL,
                             stdout=log, stderr=log, start_new_session=True, close_fds=True)
    open(IDLE_PID, "w").write(str(child.pid))
    running = sum(1 for s in call(conn, "GET", "/api/v1/sessions") if S(s, "state") == "running")
    say("已约好：daemon v%s 还不会自己等空闲，由守望进程 %d 盯着——%d 个会话还在跑，等它们都停下就重启（日志 %s；aaa restart --cancel 取消）"
        % (S(h, "version"), child.pid, running, IDLE_LOG))

def cancel_idle_watch():
    pid = idle_watch_pid()
    if not pid: say("没有在等的空闲重启"); return
    try: os.kill(pid, signal.SIGTERM)
    except OSError: pass
    try: os.remove(IDLE_PID)
    except OSError: pass
    say("取消了空闲重启（守望进程 %d）" % pid)

def cmd_idle_watch(conn, args):
    """后台守望：每 20 秒看一眼，连续 3 次没有会话在「运行」（也没有后台任务）就 --force 重启"""
    def log(m): sys.stdout.write("%s %s\n" % (time.strftime("%m-%d %H:%M:%S"), m)); sys.stdout.flush()
    log("开始等空闲（pid %d）" % os.getpid())
    quiet = 0
    while True:
        try:
            ss = conn.api("GET", "/api/v1/sessions", timeout=10)
            busy = [S(s, "title") or S(s, "id") for s in ss if S(s, "state") == "running" or s.get("background")]
        except Exception as e:
            log("看不到 daemon：%s" % e); busy = None
        if busy is None: quiet = 0
        elif busy:
            if quiet: log("又忙起来了：%s" % "、".join(busy[:5]))
            quiet = 0
        else:
            quiet += 1
            if quiet >= 3:
                try:
                    v = conn.api("POST", "/api/v1/restart", {"force": True}, timeout=60)
                    log("空闲了，重启 daemon" + ("（结束了：%s）" % "、".join(v.get("killed", [])) if v.get("killed") else ""))
                    time.sleep(3)
                    h2 = conn.wait_back()
                    log("回来了：v%s" % S(h2, "version") if h2 else "90 秒内没回来，看 daemon.err.log")
                except Exception as e:
                    log("重启失败：%s" % e)
                try: os.remove(IDLE_PID)
                except OSError: pass
                return
        time.sleep(20)

def cmd_config(conn, args):
    conn.probe()
    if not args:
        c = call(conn, "GET", "/api/v1/config")
        tok = S(c, "token"); shown = tok if "--show-token" in args else (tok[:10] + "…" if len(tok) > 10 else tok)
        out("端口     %s\ntoken    %s%s\n项目根   %s\n配置文件 %s" % (S(c, "port"), shown, "" if "--show-token" in args else DIM + "  （--show-token 看全）" + RESET, S(c, "project_root"), CFG)); return
    key = args[0]; rest = [a for a in args[1:] if not a.startswith("--")]
    force = "--force" in args
    body = {"force": force}
    if key == "port" and rest: body["port"] = int(rest[0])
    elif key == "token" and rest: body["token"] = rest[0]
    elif key == "root" and rest:
        body["project_root"] = os.path.abspath(rest[0]); body["migrate"] = "--migrate" in args
    else:
        die("用法：aaa config | config port <n> | config token <t> | config root <path> [--migrate] [--force]")
    live = live_titles(conn)
    if live and not force:
        die("有 %d 个活会话（%s）。改配置要重启 daemon；加 --force 先结束它们、起来后自动 resume" % (len(live), "、".join(live[:5])))
    v = call(conn, "PUT", "/api/v1/config", body)
    report_migration(v)
    time.sleep(2)
    h = conn.wait_back()
    if not h: die("90 秒内没回来，看 %s/daemon.err.log" % STATE)
    say("daemon v%s 回来了，项目根 %s" % (S(h, "version"), S(h, "project_root")))

def report_migration(v):
    if v.get("killed"): out("  结束的会话：" + "、".join(v["killed"]))
    r = v.get("report")
    if r:
        out("  改写：会话元数据 %s · 历史 %s · 置顶 %s · cwd 缓存 %s · Claude 目录 %s · transcript %s · ~/.claude.json 键 %s"
            % tuple(r.get(k) for k in ("session_metas", "history", "pins", "cwd_cache", "claude_dirs", "claude_files", "claude_json")))
        w = r.get("warnings") or []
        out("  warnings：%d" % len(w))
        for x in w: out("    - " + x)

# ---------------------------------------------------------------------------
# migrate-root：一键迁根（以前是 ~/aaa-migrate-root.sh）
# ---------------------------------------------------------------------------
NEED_VER = (1, 12, 1)

# 上面 restart --when-idle 也用它比 daemon 版本（以前那边另写了一个 version_tuple）
def ver_tuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v or "0")[:3]) or (0,)

def confirm(q, yes):
    if yes: return True
    if not sys.stdin.isatty(): return False
    try: a = input("%s [y/N] " % q)
    except EOFError: return False
    return a.strip().lower() in ("y", "yes")

def ppid_of(pid):
    o = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True, check=False).stdout.strip()
    return int(o) if o.isdigit() else 0

def under_daemon(pid, daemon_pids):
    """祖先链里有 aaa-daemon（会话里 Bash 起的子进程环境可能读不到，祖先链兜底）"""
    for _ in range(25):
        if pid <= 1: return False
        if pid in daemon_pids: return True
        pid = ppid_of(pid)
    return False

def procs_in(root, daemon_pids):
    """cwd 在 root 下的进程 [(pid, comm, cwd, is_aaa)]；is_aaa = 环境里有 AAA_SESSION 或祖先是 aaa-daemon"""
    try:
        outp = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fpn"], capture_output=True, text=True, check=False).stdout
    except OSError:
        return []
    res, pid = [], None
    me = os.getpid()
    for line in outp.splitlines():
        if line.startswith("p"): pid = int(line[1:])
        elif line.startswith("n") and pid:
            cwd = line[1:]
            if cwd == root or cwd.startswith(root + "/"):
                if pid == me or under_daemon(pid, {me}) : continue
                ps = subprocess.run(["ps", "-E", "-o", "comm=,command=", "-p", str(pid)], capture_output=True, text=True, check=False).stdout
                if not ps.strip(): continue  # 扫完就没了
                comm = ps.split()[0]
                res.append((pid, comm, cwd, "AAA_SESSION=" in ps or under_daemon(pid, daemon_pids)))
    return res

def daemon_pids():
    """所有 aaa-daemon 进程。不用 pgrep -x：launchd 起的那个 comm 是完整路径，pgrep 认不出来（实测只抓到游离的旧实例）"""
    outp = subprocess.run(["ps", "-axo", "pid=,comm="], capture_output=True, text=True, check=False).stdout
    res = set()
    for line in outp.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2 and os.path.basename(parts[1].strip()) == "aaa-daemon":
            res.add(int(parts[0]))
    return res

def stray_daemons(conn):
    """除了正在监听端口的那个之外的 aaa-daemon 进程（旧目录起的游离实例）"""
    try:
        listening = subprocess.run(["lsof", "-nP", "-iTCP:%d" % conn.port, "-sTCP:LISTEN", "-Fp"], capture_output=True, text=True, check=False).stdout
        serving = {int(l[1:]) for l in listening.splitlines() if l.startswith("p")}
    except OSError:
        return []
    res = []
    for p in sorted(daemon_pids()):
        if p in serving: continue
        cmd = subprocess.run(["ps", "-o", "command=", "-p", str(p)], capture_output=True, text=True, check=False).stdout.strip()
        res.append((p, cmd))
    return res

def cmd_migrate_root(conn, args):
    if os.getuid() == 0: die("不要用 sudo：脚本只跟 daemon 说话，用你自己的账号跑")
    if not conn.local: die("迁根只能在 daemon 所在的机器上做")
    rest = [a for a in args if not a.startswith("-")]
    if not rest: die("用法：aaa migrate-root <新根> [--yes]")
    yes = "--yes" in args or "-y" in args
    new_root = os.path.abspath(rest[0])
    h = conn.probe()
    old_root = S(h, "project_root")
    if not os.path.isdir(old_root): die("旧根不存在：%s（是不是已经迁过了？）" % old_root)
    if os.path.exists(new_root) and os.listdir(new_root): die("目标已存在且非空：%s" % new_root)
    say("daemon 当前 v%s，update_pending=%s，项目根 %s → %s" % (S(h, "version"), bool(h.get("update_pending")), old_root, new_root))

    # 1) 游离的旧 daemon
    for pid, cmd in stray_daemons(conn):
        out("%s发现不在服务的 aaa-daemon 进程%s：pid %d  %s" % (YELLOW, RESET, pid, cmd))
        if confirm("结束它？", yes):
            try: os.kill(pid, signal.SIGTERM); out("  已发 TERM")
            except OSError as e: out("  失败：%s" % e)

    # 2) 旧根里还有谁在跑（不是 daemon 起的）
    say("检查还在 %s 里跑的进程（AAA 自己的会话会被收掉再按新路径 resume，不用管）" % old_root)
    foreign = [p for p in procs_in(old_root, daemon_pids()) if not p[3]]
    if foreign:
        out("这些进程的 cwd 在旧根里、不是 daemon 起的（其它 agent 会继续往旧目录写 transcript；你的终端 shell 在这里也会列出来，无碍）：")
        for pid, comm, cwd, _ in foreign: out("  pid %-6d %-10s cwd=%s" % (pid, comm, cwd))
        if not confirm("继续？", yes): die("先把它们关掉再来")
    else:
        out("  没有")

    # 3) 让 ≥NEED_VER 的 daemon 跑起来
    if ver_tuple(S(h, "version")) < NEED_VER or h.get("update_pending"):
        say("重启 daemon 换上新二进制（会话会自动 resume）")
        if not confirm("会先结束所有会话，继续？", yes): die("取消")
        call(conn, "POST", "/api/v1/restart", {"force": True})
        time.sleep(2)
        h = conn.wait_back() or die("daemon 重启后 90 秒内没回来，看 %s/daemon.err.log" % STATE)
        say("回来了：v%s" % S(h, "version"))
        if ver_tuple(S(h, "version")) < NEED_VER:
            die("跑起来的还是 v%s，~/.local/bin/aaa-daemon 不是 ≥%s？" % (S(h, "version"), ".".join(map(str, NEED_VER))))
        say("等会话自动 resume 收尾")
        last, stable = -1, 0
        for _ in range(40):
            try: n = len(call(conn, "GET", "/api/v1/sessions"))
            except SystemExit: n = 0
            stable = stable + 1 if n == last else 0; last = n
            if stable >= 3: break
            time.sleep(1)
        out("  会话 %d 条" % last)

    # 4) 迁移
    say("迁移：%s → %s（收会话 → 搬目录 → 改所有指向 → daemon 重启 → 按新路径 resume）" % (old_root, new_root))
    if not confirm("开始？", yes): die("取消")
    v = call(conn, "PUT", "/api/v1/config", {"project_root": new_root, "migrate": True, "force": True})
    report_migration(v)
    time.sleep(2)
    h = conn.wait_back() or die("迁移后 daemon 90 秒内没回来，看 %s/daemon.err.log；目录应已在 %s，配置已写" % (STATE, new_root))
    if S(h, "project_root") != new_root: die("daemon 回来了但项目根是 %s" % S(h, "project_root"))
    say("daemon v%s 已在 %s 上运行" % (S(h, "version"), new_root))

    # 5) mac 客户端本机偏好里的静音路径
    ui = os.path.join(HOME, ".config", "aaa-ui", "ui.toml")
    if os.path.isfile(ui):
        body = open(ui, encoding="utf-8").read()
        if old_root in body:
            open(ui + ".bak-migrate", "w", encoding="utf-8").write(body)
            open(ui, "w", encoding="utf-8").write(body.replace(old_root, new_root))
            out("  ui.toml 里的静音路径已改（备份 %s.bak-migrate）" % ui)
    say("完成。%d 个条目在 %s" % (len(os.listdir(new_root)), new_root))
    out("  · 终端里的 shell 若还站在旧路径，cd 一下：cd %s\n  · 会话正在按新路径自动 resume，几秒后在 AAA 里能看到\n  · 手机上的「静音项目」会在下次连上时自动改成新路径" % new_root)

def cmd_backfill(conn, args):
    """给看板里没有进度清单的会话补清单（daemon 后台按 transcript 用 haiku 生成）"""
    conn.probe()
    v = call(conn, "POST", "/api/v1/history/backfill")
    say("已开始：%d 个会话没有清单，daemon 在后台逐个补（每条几秒，看板会陆续出现）" % v.get("missing", 0))

def cmd_service(conn, args):
    sub = args[0] if args else "status"
    if sub not in ("install", "uninstall", "status"): die("用法：aaa service install|uninstall|status")
    os.execvp("aaa-daemon", ["aaa-daemon", "service", sub])

COMMANDS = {"backfill": cmd_backfill, "status": cmd_status, "st": cmd_status, "ls": cmd_ls, "wait": cmd_wait, "perms": cmd_perms,
            "permissions": cmd_perms, "restart": cmd_restart, "_idle-watch": cmd_idle_watch, "config": cmd_config, "migrate-root": cmd_migrate_root,
            "service": cmd_service}

def main():
    argv = sys.argv[1:]
    cmd = argv[0] if argv and not argv[0].startswith("-") else "status"
    args = argv[1:] if argv and not argv[0].startswith("-") else argv
    if cmd in ("help", "-h", "--help"): sys.stdout.write(HELP); return
    if cmd in ("version", "-V", "--version"): out("aaa %s" % VERSION); return
    if cmd not in COMMANDS:
        sys.stderr.write("%saaa:%s 未知命令 %s（项目 / 会话管理请用 Mac App 或手机）\n\n%s" % (GREY, RESET, cmd, HELP)); sys.exit(1)
    if cmd == "service": cmd_service(None, args); return
    COMMANDS[cmd](Conn(), args)

if __name__ == "__main__":
    main()
