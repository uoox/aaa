# resolve TARGET [--live] → R_*. Returns 0, or 2 when nothing matched, or 1
# for an error that must not be guessed past (ambiguous prefix/name, row out
# of range, `.` outside the project root); the message is in $ERRFILE.
resolve() {
  local target=$1 live=${2:-} health='{}' sessions line rc
  if [ "$target" = . ]; then health=$(api GET /api/v1/health) || die_api; fi
  sessions=$(api GET /api/v1/sessions) || die_api
  line=$(printf '%s' "$sessions" | AAA_BARE=1 py resolve "$target" "$(pwd -P)" "$health" $live 2>"$ERRFILE"); rc=$?
  [ $rc -eq 0 ] || return $rc
  IFS=$US read -r R_ID R_CERT R_PROJECT R_STATE R_PATH R_AGENT R_TITLE <<<"$line"
}

# aaa kill 2 resolves against a list that reshuffles whenever an agent prints,
# so a positional target is echoed and confirmed; an id goes straight through;
# non-interactive callers never get a prompt
confirm_destructive() {
  local ans
  [ "$R_CERT" = exact ] && return 0
  is_tty || return 0
  printf '%s %s%s%s · %s %s%s%s [y/N]: ' "$1" "$BOLD" "$R_PROJECT" "$RESET" "$R_STATE" "$DIM" "$R_ID" "$RESET"
  read -r ans || return 1
  case $ans in y|Y|yes) return 0;; *) return 1;; esac
}

# attach_raw ID TITLE → 0 detached, 3 ended, 1 error (message already printed)
attach_raw() {
  AAA_TOKEN="$TOKEN" AAA_WS_HOST="$HOST" AAA_WS_PORT="$PORT" AAA_LOCAL="$LOCAL" \
    python3 -c "$PY_SRC" attach "$1" "$2"
}

do_attach() {
  is_tty || die "attach 需要交互式终端"
  attach_raw "$1" "$2"
  case $? in
    0) printf '%s已脱离 %s（仍在运行）%s\n' "$DIM" "$1" "$RESET" ;;
    3) printf '%s%s 已结束%s\n' "$DIM" "$1" "$RESET" ;;
    *) exit 1 ;;
  esac
}

