# ---- attach: a minimal WebSocket client over the raw tty ----
def cmd_attach(args):
    import base64, hashlib, select, socket, struct, termios, tty
    sid = args[0]
    title = args[1] if len(args) > 1 else sid
    if not (os.isatty(0) and os.isatty(1)):
        die("attach 需要交互式终端")
    host = os.environ.get("AAA_WS_HOST", "127.0.0.1")
    port = int(os.environ.get("AAA_WS_PORT", "2730"))
    token = os.environ.get("AAA_TOKEN", "")
    local = os.environ.get("AAA_LOCAL") == "1"
    authority = ("[%s]" % host if ":" in host and not host.startswith("[") else host) + ":%d" % port

    try:
        sock = socket.create_connection((host, port), timeout=2 if local else 6)
    except OSError as e:
        die("连接 %s 失败: %s" % (authority, e))
    try:
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
    except OSError:
        pass

    key = base64.b64encode(os.urandom(16)).decode()
    req = ("GET /api/v1/sessions/%s/attach HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\n"
           "Connection: Upgrade\r\nSec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n"
           "Authorization: Bearer %s\r\n\r\n" % (sid, authority, key, token))
    try:
        sock.sendall(req.encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = sock.recv(4096)
            if not chunk:
                die("WebSocket 握手失败: 连接被关闭")
            buf += chunk
            if len(buf) > 65536:
                die("WebSocket 握手失败: 响应头过大")
    except socket.timeout:
        die("WebSocket 握手超时（%s）" % authority)
    except OSError as e:
        die("WebSocket 握手失败: %s" % e)
    head, buf = buf.split(b"\r\n\r\n", 1)
    lines = head.decode("latin-1").split("\r\n")
    status = lines[0].split(" ")
    hdrs = {}
    for l in lines[1:]:
        if ":" in l:
            k, v = l.split(":", 1)
            hdrs[k.strip().lower()] = v.strip()
    if len(status) < 2 or status[1] != "101":
        # an ordinary HTTP error: collect the body for its message
        try:
            want = int(hdrs.get("content-length", "0"))
            while len(buf) < want:
                chunk = sock.recv(4096)
                if not chunk:
                    break
                buf += chunk
        except (OSError, ValueError):
            pass
        msg = err_message(buf.decode("utf-8", "replace")) or lines[0]
        die("HTTP %s: %s" % (status[1] if len(status) > 1 else "?", msg))
    expect = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
    if hdrs.get("sec-websocket-accept") != expect:
        die("WebSocket 握手失败: Sec-WebSocket-Accept 不匹配")
    sock.settimeout(None)

    def mask_bytes(k, data):
        n = len(data)
        if n == 0:
            return data
        full = (k * (n // 4 + 1))[:n]
        return (int.from_bytes(data, "big") ^ int.from_bytes(full, "big")).to_bytes(n, "big")

    def build(opcode, payload):
        k = os.urandom(4)
        hdr = bytearray([0x80 | opcode])
        n = len(payload)
        if n < 126:
            hdr.append(0x80 | n)
        elif n < 65536:
            hdr.append(0x80 | 126); hdr += struct.pack(">H", n)
        else:
            hdr.append(0x80 | 127); hdr += struct.pack(">Q", n)
        return bytes(hdr) + k + mask_bytes(k, payload)

    def parse(b):
        if len(b) < 2:
            return None
        fin, op = b[0] & 0x80, b[0] & 0x0F
        masked, ln, pos = b[1] & 0x80, b[1] & 0x7F, 2
        if ln == 126:
            if len(b) < 4: return None
            ln, pos = struct.unpack(">H", b[2:4])[0], 4
        elif ln == 127:
            if len(b) < 10: return None
            ln, pos = struct.unpack(">Q", b[2:10])[0], 10
        k = None
        if masked:
            if len(b) < pos + 4: return None
            k, pos = b[pos:pos + 4], pos + 4
        if len(b) < pos + ln:
            return None
        payload = b[pos:pos + ln]
        if k:
            payload = mask_bytes(k, payload)
        return fin, op, payload, pos + ln

    def write_all(fd, data):
        while data:
            try:
                n = os.write(fd, data)
            except BlockingIOError:
                select.select([], [fd], [])
                continue
            data = data[n:]

    def send(data):
        try:
            sock.sendall(data); return True
        except OSError:
            return False

    def size():
        try:
            sz = os.get_terminal_size(1)
            return sz.columns, sz.lines
        except OSError:
            return 120, 40

    winch = [True]
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_r, False); os.set_blocking(wake_w, False)
    signal.set_wakeup_fd(wake_w)
    signal.signal(signal.SIGWINCH, lambda *_: winch.__setitem__(0, True))
    def on_term(*_): raise SystemExit(1)
    for sg in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sg, on_term)

    saved = termios.tcgetattr(0)
    outcome = 3   # 0 = detached (Ctrl-]), 3 = the session or the socket ended
    # full raw: the remote PTY already did its own output processing
    tty.setraw(0, termios.TCSANOW)
    try:
        write_all(1, b"\x1b[2J\x1b[H" + ("%s── %s%s%s%s · Ctrl-] 脱离（会话继续运行）──%s\r\n"
                                          % (DIM, BOLD, title, RESET, DIM, RESET)).encode("utf-8"))
        frag_binary = False
        while True:
            if winch[0]:
                winch[0] = False
                c, r = size()
                if not send(build(0x1, json.dumps({"t": "resize", "cols": c, "rows": r}).encode())):
                    break
            rl, _, _ = select.select([0, sock, wake_r], [], [])
            if wake_r in rl:
                try:
                    os.read(wake_r, 4096)
                except OSError:
                    pass
            if 0 in rl:
                try:
                    data = os.read(0, 4096)
                except OSError:
                    data = b""
                if not data:
                    outcome = 0; break
                i = data.find(b"\x1d")
                if i >= 0:
                    if i > 0:
                        send(build(0x2, data[:i]))
                    send(build(0x8, b"\x03\xe8"))
                    outcome = 0; break
                if not send(build(0x2, data)):
                    break
            if sock in rl:
                try:
                    chunk = sock.recv(65536)
                except OSError:
                    chunk = b""
                if not chunk:
                    break
                buf += chunk
                closed = False
                while True:
                    fr = parse(buf)
                    if fr is None:
                        break
                    fin, op, payload, used = fr
                    buf = buf[used:]
                    if op == 0x2:
                        frag_binary = not fin
                        write_all(1, payload)
                    elif op == 0x0:
                        if frag_binary:
                            write_all(1, payload)
                        if fin:
                            frag_binary = False
                    elif op == 0x1:
                        frag_binary = False      # hello / control JSON: nothing to show
                    elif op == 0x9:
                        send(build(0xA, payload))
                    elif op == 0x8:
                        send(build(0x8, payload[:2]))
                        closed = True; break
                if closed:
                    break
    finally:
        termios.tcsetattr(0, termios.TCSANOW, saved)
        write_all(1, RESET.encode() + b"\r\n")
        try:
            sock.close()
        except OSError:
            pass
    sys.exit(outcome)

