  v=$(api POST /api/v1/mac/permissions/request "{\"ids\":$ids}") || die_api
  printf '%s' "$v" | py perm-summary
  printf '%s弹窗出现在 Mac 上；辅助功能/屏幕录制/完全磁盘访问 要在系统设置里勾上 aaa-daemon，改完重启 daemon 才能读到%s\n' "$DIM" "$RESET"
}

cmd_new() {
  local name=$1 agent=$2 p ppath pname s sid
  p=$(api POST /api/v1/projects "$(printf '{"name":%s,"agent":%s}' "$(json_str "$name")" "$(json_str "$agent")")") || die_api
  IFS=$US read -r ppath pname <<<"$(printf '%s' "$p" | py fields path name)"
  s=$(create_session "$ppath" "$agent" false false) || die_api
  sid=$(printf '%s' "$s" | py fields id)
  if is_tty; then
    attach_raw "$sid" "$pname · 新会话"
    printf '%s%s · %s%s\n' "$DIM" "$ppath" "$sid" "$RESET"
  else
    printf '%s\n' "$sid"
  fi
}

# an existing live session wins; otherwise resume the project's agent.
# --fresh skips the reuse and asks for a parallel session in that project.
cmd_open() {
  local t=$1 ppath pagent pname projects health='{}' line s sid sproject stitle fresh=false rc
  if [ "$FRESH" = 1 ]; then
    fresh=true
    resolve "$t"; rc=$?
    case $rc in
      0) ppath=$R_PATH; pagent=$R_AGENT; pname=$R_PROJECT ;;
      2) ;;            # no session by that name: look the project up below
      *) die_api ;;    # ambiguous / out of range: never guess
    esac
  else
    resolve "$t" --live; rc=$?
    case $rc in
      0) do_attach "$R_ID" "$R_PROJECT · $R_TITLE"; return ;;
      2) ;;
      *) die_api ;;
    esac
  fi
  if [ -z "$ppath" ]; then
    projects=$(api GET /api/v1/projects) || die_api
    if [ "$t" = . ]; then health=$(api GET /api/v1/health) || die_api; fi
    line=$(printf '%s' "$projects" | AAA_BARE=1 py find-project "$t" "$(pwd -P)" "$health" 2>"$ERRFILE") || die_api
    IFS=$US read -r ppath pagent pname <<<"$line"
  fi
  s=$(create_session "$ppath" "$pagent" true "$fresh") || die_api
  IFS=$US read -r sid sproject stitle <<<"$(printf '%s' "$s" | py fields id project_name title)"
  do_attach "$sid" "${sproject:-$pname} · $stitle"
}

cmd_attach() {
  resolve "$1" || die_api
  do_attach "$R_ID" "$R_PROJECT · $R_TITLE"
}

cmd_say() {
  resolve "$1" || die_api
  api POST "/api/v1/sessions/$R_ID/input" "{\"text\":$(json_str "$2"),\"enter\":true}" >/dev/null || die_api
  printf '%s→ %s · %s%s\n' "$DIM" "$R_PROJECT" "$R_ID" "$RESET"
}

cmd_kill() {
  resolve "$1" || die_api
  confirm_destructive "结束" || { printf '%s已取消%s\n' "$DIM" "$RESET"; return; }
  api POST "/api/v1/sessions/$R_ID/kill" '{}' >/dev/null || die_api
  printf '已结束 %s · %s\n' "$R_PROJECT" "$R_ID"
}

cmd_rm() {
  resolve "$1" || die_api
  confirm_destructive "删除记录" || { printf '%s已取消%s\n' "$DIM" "$RESET"; return; }
  api DELETE "/api/v1/sessions/$R_ID" >/dev/null || die_api
  printf '已删除记录 %s · %s\n' "$R_PROJECT" "$R_ID"
}

cmd_rename() {
  resolve "$1" || die_api
  api POST "/api/v1/sessions/$R_ID/rename" "{\"title\":$(json_str "$2")}" >/dev/null || die_api
  printf '%s → %s\n' "$R_ID" "$2"
}

# ---------------------------------------------------------------------------
# the interactive menu
# ---------------------------------------------------------------------------
# read_key [TIMEOUT] → KEY ∈ up down enter esc ctrl-c eof timeout | the char
read_key() {
  local c rest rc
  if [ -n "${1:-}" ]; then IFS= read -rsn1 -t "$1" c; rc=$?
  else IFS= read -rsn1 c; rc=$?; fi
  if [ $rc -ne 0 ]; then
    if [ -n "${1:-}" ]; then KEY=timeout; else KEY=eof; fi
    return
  fi
  case $c in
    $'\033')
      if IFS= read -rsn2 -t 1 rest; then
        case $rest in '[A'|'OA') KEY=up;; '[B'|'OB') KEY=down;; *) KEY=other;; esac
      else
        KEY=esc
      fi ;;
    ''|$'\r'|$'\n') KEY=enter ;;
    $'\003') KEY=ctrl-c ;;
    *) KEY=$c ;;
  esac
}

# a row number typed as one or two digits; the second digit has a second to arrive
read_number() { # FIRST-DIGIT COUNT → prints n
  local n=$1 d
  if [ "$2" -gt 9 ]; then
    if IFS= read -rsn1 -t 1 d && [ -n "$d" ]; then
      case $d in [0-9]) [ $((n * 10 + d)) -le "$2" ] && n=$((n * 10 + d)) ;; esac
    fi
  fi
  printf '%s' "$n"
}

map_row() { awk -F "$US" -v n="$1" '$1 == n { print; exit }' "$MAPFILE"; }
map_count() { wc -l <"$MAPFILE" | tr -d ' '; }

prompt() { # LABEL → REPLY_LINE (cooked line input: IME and editing come free)
  clear_screen
  printf '  %s%s%s: ' "$BOLD" "$1" "$RESET"
  IFS= read -r REPLY_LINE
}

confirm() {
  local ans
  printf '\n  %s%s%s [y/N]: ' "$YELLOW" "$1" "$RESET"
  read -r ans || return 1
  case $ans in y|Y|yes) return 0;; *) return 1;; esac
}

# pick_agent TITLE → PICKED (agent id), or 1 when cancelled
pick_agent() {
  local title=$1 idx=0 agents count line
  agents=$(api GET /api/v1/agents) || return 1
  clear_screen
  while :; do
    printf '%s' "$agents" | py menu-pick "$MAPFILE" "$title" "$idx"
    count=$(map_count)
    [ "$count" -gt 0 ] || return 1
    read_key
    case $KEY in
      up) idx=$(( (idx + count - 1) % count )) ;;
      down) idx=$(( (idx + 1) % count )) ;;
      enter) line=$(map_row $((idx + 1))); IFS=$US read -r _ PICKED _ <<<"$line"; return 0 ;;
      [1-9]) if [ "$KEY" -le "$count" ]; then line=$(map_row "$KEY"); IFS=$US read -r _ PICKED _ <<<"$line"; return 0; fi ;;
      q|esc|ctrl-c|eof) return 1 ;;
    esac
  done
}

# menu_attach ID TITLE NAME → MENU_STATUS
menu_attach() {
  clear_screen
  attach_raw "$1" "$2"
  case $? in
    0) MENU_STATUS="已脱离 $3（仍在运行）" ;;
    3) MENU_STATUS="$3 会话已结束" ;;
    *) MENU_STATUS="attach 失败" ;;
  esac
}

# a live session of the project if it has one, else resume the project's agent
menu_open_project() { # PATH AGENT NAME
  local sessions line sid stitle s
  sessions=$(api GET /api/v1/sessions) || { MENU_STATUS=$(cat "$ERRFILE"); return; }
  line=$(printf '%s' "$sessions" | py live-for-path "$1")
  if [ -n "$line" ]; then
    IFS=$US read -r sid stitle <<<"$line"
  else
    s=$(create_session "$1" "$2" true false) || { MENU_STATUS=$(cat "$ERRFILE"); return; }
    IFS=$US read -r sid stitle <<<"$(printf '%s' "$s" | py fields id title)"
  fi
  menu_attach "$sid" "$3 · $stitle" "$3"
}

# new folder + a fresh session, no git anything
menu_new_project() { # AGENT
  local p ppath pname s sid
  prompt "项目名（留空=时间戳）" || { MENU_STATUS=''; return; }
  p=$(api POST /api/v1/projects "$(printf '{"name":%s,"agent":%s}' "$(json_str "$REPLY_LINE")" "$(json_str "$1")")") \
    || { MENU_STATUS=$(cat "$ERRFILE"); return; }
  IFS=$US read -r ppath pname <<<"$(printf '%s' "$p" | py fields path name)"
  s=$(create_session "$ppath" "$1" false false) || { MENU_STATUS=$(cat "$ERRFILE"); return; }
  sid=$(printf '%s' "$s" | py fields id)
  clear_screen
  attach_raw "$sid" "$pname · 新会话"
  case $? in
    0) MENU_STATUS="已建 $pname 并脱离（仍在运行）" ;;
    3) MENU_STATUS="$pname 会话已结束" ;;
    *) MENU_STATUS="attach 失败" ;;
  esac
}

menu_projects() {
  local idx=0 status='' projects new count line ppath pagent pname resp
  printf '\033[2J\033[H  %s读取项目…%s' "$DIM" "$RESET"
  projects=$(api GET /api/v1/projects) || { MENU_STATUS=$(cat "$ERRFILE"); return; }
  clear_screen
  while :; do
    printf '%s' "$projects" | py menu-projects "$MAPFILE" "$idx" "$status"
    count=$(map_count)
    [ "$count" -gt 0 ] && [ "$idx" -ge "$count" ] && idx=$((count - 1))
    read_key
    case $KEY in
      up) [ "$count" -gt 0 ] && idx=$(( (idx + count - 1) % count )) ;;
      down) [ "$count" -gt 0 ] && idx=$(( (idx + 1) % count )) ;;
      [1-9]|enter)
        if [ "$KEY" != enter ]; then
          [ "$KEY" -le "$count" ] || continue
          idx=$((KEY - 1))
        fi
        [ "$count" -gt 0 ] || continue
        line=$(map_row $((idx + 1))); IFS=$US read -r _ ppath pagent pname <<<"$line"
        menu_open_project "$ppath" "$pagent" "$pname"; status=$MENU_STATUS
        new=$(api GET /api/v1/projects) && projects=$new
        clear_screen ;;
      a)
        [ "$count" -gt 0 ] || continue
        line=$(map_row $((idx + 1))); IFS=$US read -r _ ppath pagent pname <<<"$line"
        if pick_agent "换 agent"; then
          if api POST /api/v1/projects/agent "$(printf '{"path":%s,"agent":%s}' "$(json_str "$ppath")" "$(json_str "$PICKED")")" >/dev/null; then
            status="$pname → $PICKED"
            new=$(api GET /api/v1/projects) && projects=$new
          else
            status=$(cat "$ERRFILE")
          fi
        fi
        clear_screen ;;
      d)
        [ "$count" -gt 0 ] || continue
        line=$(map_row $((idx + 1))); IFS=$US read -r _ ppath pagent pname <<<"$line"
        if confirm "删除 $pname 及其全部 agent 会话记录?"; then
          if resp=$(api POST /api/v1/projects/delete "{\"paths\":[$(json_str "$ppath")]}"); then
            status=$(printf '%s' "$resp" | py purge-summary "$pname")
            new=$(api GET /api/v1/projects) && projects=$new
          else
            status=$(cat "$ERRFILE")
          fi
        fi
        clear_screen ;;
      n)
        if pick_agent "新项目用哪个 agent"; then
          menu_new_project "$PICKED"; status=$MENU_STATUS
          new=$(api GET /api/v1/projects) && projects=$new
        fi
        clear_screen ;;
      r) new=$(api GET /api/v1/projects) && projects=$new; status='' ;;
      q|esc|ctrl-c|eof) break ;;
    esac
  done
  MENU_STATUS=$status
  clear_screen
}

menu_request_perms() { # IDS-JSON → prints summary or error
  local v
  if v=$(api POST /api/v1/mac/permissions/request "{\"ids\":$1}"); then
    printf '%s' "$v" | py perm-summary
  else
    cat "$ERRFILE"
  fi
}

menu_perms() {
  local idx=0 status='' perms new count line pid
  perms=$(api GET /api/v1/mac/permissions) || { MENU_STATUS=$(cat "$ERRFILE"); return; }
  clear_screen
  while :; do
    printf '%s' "$perms" | py menu-perms "$MAPFILE" "$idx" "$status"
    count=$(map_count)
    [ "$count" -gt 0 ] && [ "$idx" -ge "$count" ] && idx=$((count - 1))
    read_key
    case $KEY in
      up) [ "$count" -gt 0 ] && idx=$(( (idx + count - 1) % count )) ;;
      down) [ "$count" -gt 0 ] && idx=$(( (idx + 1) % count )) ;;
      enter)
        [ "$count" -gt 0 ] || continue
        line=$(map_row $((idx + 1))); IFS=$US read -r _ pid _ <<<"$line"
        status=$(menu_request_perms "[$(json_str "$pid")]")
        new=$(api GET /api/v1/mac/permissions) && perms=$new ;;
      a)
        if confirm "弹窗会出现在这台 Mac 上，逐个允许。开始?"; then
          status=$(menu_request_perms '["all"]')
          new=$(api GET /api/v1/mac/permissions) && perms=$new
        fi
        clear_screen ;;
      r) new=$(api GET /api/v1/mac/permissions) && perms=$new; status='' ;;
      q|esc|ctrl-c|eof) break ;;
    esac
  done
  MENU_STATUS=$status
  clear_screen
}

menu() {
  is_tty || die "交互菜单需要终端；试试 aaa ls / aaa help"
  local status='' sessions health new count n line sid sproject stitle
  IN_MENU=1
  SAVED_STTY=$(stty -g 2>/dev/null)
  health=$(api GET /api/v1/health) || die_api
  sessions=$(api GET /api/v1/sessions) || sessions='[]'
  clear_screen
  while :; do
    printf '{"health":%s,"sessions":%s}' "$health" "$sessions" | py menu "$MAPFILE" "$HOST" "$PORT" "$status"
    count=$(map_count)
    read_key 2
    case $KEY in
      timeout)
        # idle refresh: a grant landing or a session flipping to 待回复 should
        # show up without a keypress
        new=$(api GET /api/v1/sessions) && sessions=$new
        new=$(api GET /api/v1/health) && health=$new ;;
      [1-9])
        n=$(read_number "$KEY" "$count")
        line=$(map_row "$n")
        if [ -n "$line" ]; then
          IFS=$US read -r _ sid sproject stitle <<<"$line"
          menu_attach "$sid" "$sproject · $stitle" "$sproject"; status=$MENU_STATUS
          new=$(api GET /api/v1/sessions) && sessions=$new
          clear_screen
        fi ;;
      p) menu_projects; status=$MENU_STATUS
         new=$(api GET /api/v1/sessions) && sessions=$new ;;
      m) menu_perms; status=$MENU_STATUS ;;
      n) if pick_agent "新项目用哪个 agent"; then menu_new_project "$PICKED"; status=$MENU_STATUS; fi
         new=$(api GET /api/v1/sessions) && sessions=$new
         clear_screen ;;
      r) new=$(api GET /api/v1/sessions) && sessions=$new
         new=$(api GET /api/v1/health) && health=$new
         status='' ;;
      q|esc|ctrl-c|eof) break ;;
    esac
  done
  clear_screen
}

# ---------------------------------------------------------------------------
# argument parsing and dispatch
# ---------------------------------------------------------------------------
cmd=${1:-}
[ $# -gt 0 ] && shift

case $cmd in
  help|-h|--help) printf '%s' "$HELP"; exit 0 ;;
  -V|--version|version) printf 'aaa %s\n' "$VERSION"; exit 0 ;;
  ''|ls|ps|projects|wait|status|st|perms|permissions|new|n|open|o|attach|a|kill|k|rm|say|answer|rename) ;;
  *) printf '%saaa:%s 未知命令 %s；aaa help 看用法\n\n%s' "$GREY" "$RESET" "$cmd" "$HELP" >&2; exit 1 ;;
esac

command -v curl >/dev/null 2>&1 || die "需要 curl"
command -v python3 >/dev/null 2>&1 || die "需要 python3"
ERRFILE=$(mktemp "${TMPDIR:-/tmp}/aaa.err.XXXXXX") || die "mktemp 失败"
MAPFILE=$(mktemp "${TMPDIR:-/tmp}/aaa.map.XXXXXX") || die "mktemp 失败"
HDRFILE=$(umask 077 && mktemp "${TMPDIR:-/tmp}/aaa.hdr.XXXXXX") || die "mktemp 失败"
chmod 600 "$HDRFILE"

# flags belong to verbs: ls takes -a/--all/--json, the other listings --json,
# new -a/--agent AGENT, open --fresh. Nothing else is a flag — `aaa say 2 yes
# -v` sends "yes -v" — `--` ends flag parsing, and for say/rename parsing
# stops at the target so the rest of the line is verbatim text.
POS=(); AGENT_FLAG=''; JSON=0; ALL=0; FRESH=0
skip=0; flags_done=0
for a in "$@"; do
  if [ $skip = 1 ]; then AGENT_FLAG=$a; skip=0; continue; fi
  if [ $flags_done = 0 ]; then
    case "$cmd:$a" in
      *:--) flags_done=1; continue ;;
      ls:-a|ls:--all) ALL=1; continue ;;
      ls:--json|ps:--json|projects:--json|wait:--json|status:--json|st:--json|perms:--json|permissions:--json) JSON=1; continue ;;
      new:-a|new:--agent|n:-a|n:--agent) skip=1; continue ;;
      open:--fresh|o:--fresh) FRESH=1; continue ;;
    esac
  fi
  POS+=("$a")
  case $cmd in say|answer|rename) flags_done=1 ;; esac
done
npos=${#POS[@]}
target=''; [ "$npos" -gt 0 ] && target=${POS[0]}
need_target() { [ -n "$target" ] || die "缺少目标；aaa ls 看有哪些会话"; }

discover
# curl config syntax; the token is the only secret and it never enters argv
printf 'header = "Authorization: Bearer %s"\n' "$(printf '%s' "$TOKEN" | sed 's/[\\"]/\\&/g')" >"$HDRFILE"
probe

case $cmd in
  '') menu ;;
  ls) cmd_ls ;;
  ps|projects) cmd_ps ;;
  wait) cmd_wait ;;
  status|st) cmd_status ;;
  perms|permissions)
    if [ "$npos" -eq 0 ]; then cmd_perms; else cmd_perms_request "${POS[@]}"; fi ;;
  new|n) cmd_new "$target" "${AGENT_FLAG:-claude}" ;;
  open|o) need_target; cmd_open "$target" ;;
  attach|a) need_target; cmd_attach "$target" ;;
  kill|k) need_target; cmd_kill "$target" ;;
  rm) need_target; cmd_rm "$target" ;;
  say|answer)
    [ "$npos" -ge 2 ] || die "用法: aaa say <目标> <文本…>"
    cmd_say "$target" "${POS[*]:1}" ;;
  rename)
    [ "$npos" -ge 2 ] || die "用法: aaa rename <目标> <标题>"
    cmd_rename "$target" "${POS[*]:1}" ;;
esac
